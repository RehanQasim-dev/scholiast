{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scholiast",
  "version": "0.1.0",
  "identifier": "app.scholiast.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Scholiast",
        "width": 1280,
        "height": 800,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/tmp/**", "$APPDATA/frames/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["scholiast"]
      },
      "mobile": [
        {
          "scheme": ["scholiast"]
        }
      ]
    }
  }
}
